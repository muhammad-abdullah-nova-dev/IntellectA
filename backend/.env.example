# IntellectA Backend Configuration
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Database (PostgreSQL + asyncpg / Neon)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/intellecta_v2

# Cache & Sessions (Upstash REST or local Redis)
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_TTL_SECONDS=86400

# Long-term memory (optional)
MEM0_API_KEY=
MEM0_USER_ID_PREFIX=intellecta

# Auth & Security
JWT_SECRET_KEY=your_super_secret_key_at_least_32_characters_long
JWT_EXPIRE_DAYS=7

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server & CORS
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
